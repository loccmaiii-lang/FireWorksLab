{
  "version": "0.2.0",
  "description": "FireWorksLab 烘焙器共用组件库：专业桌面深色主题。颜色 = 4.9.124 页面上实际用的颜色，一个都不改；圆角 = 现在的小圆角（接近直角）；状态层、焦点、动效的数值本库自己维护（state / ease / motion），尺寸按 30 px 参数行收紧。只管界面，不管烟花渲染。",
  "color": {
    "surface": "#111d21",
    "surface-low": "#121f24",
    "surface-container": "#1b2a2f",
    "surface-high": "#24373d",
    "on-surface": "#e4edef",
    "on-surface-muted": "#b4c5cb",
    "primary": "#00d49b",
    "on-primary": "#062a23",
    "primary-container": "#173d39",
    "on-primary-container": "#a1ded0",
    "primary-bright": "#36e4b0",
    "control-border": "#39515a",
    "outline": "#8da3ac",
    "divider": "#2b4149",
    "error": "#e7735a",
    "error-container": "#3f2525",
    "warning": "#e4bb7c",
    "warning-container": "#40321e",
    "success": "#81d8b6",
    "success-container": "#173d39",
    "focus": "#36e4b0"
  },
  "type": {
    "page-size": 24,
    "page-line": 32,
    "section-size": 18,
    "section-line": 26,
    "body-size": 14,
    "body-line": 22,
    "field-size": 13,
    "field-line": 20,
    "control-size": 12,
    "control-line": 18,
    "helper-size": 12,
    "helper-line": 18
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32
  },
  "radius": {
    "control": 4,
    "inner": 0,
    "toggle": 2,
    "panel": 4,
    "menu": 7,
    "menu-item": 5,
    "dialog": 10,
    "badge": 4
  },
  "size": {
    "control-compact": 32,
    "control-comfortable": 40,
    "control-inline": 26,
    "parameter-row": 30,
    "icon": 18,
    "switch-w": 32,
    "switch-h": 16,
    "check": 16,
    "menu-item": 32,
    "target-coarse": 48
  },
  "state": {
    "hover": 0.08,
    "focus": 0.12,
    "pressed": 0.12,
    "dragged": 0.16,
    "disabled": 0.38
  },
  "motion": {
    "short": 100,
    "medium": 150,
    "panel": 200,
    "large": 250,
    "tooltip-delay": 500,
    "feedback-ms": 100,
    "panel-ms": 200
  },
  "ease": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)"
  }
}
